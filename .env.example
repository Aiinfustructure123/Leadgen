# ─────────────────────────────────────────────────────────────
# One Homes AI Lead Concierge — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Anthropic
ANTHROPIC_API_KEY=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=         # whatsapp:+44...  (dedicated business number)
TWILIO_TEMPLATE_INTRO_SID=    # approved Content template SID for first contact
# Optional: exact public URL Twilio posts to, used for signature verification
# behind proxies. Leave blank to auto-derive from request headers.
TWILIO_WEBHOOK_URL=

# Resend
RESEND_API_KEY=
EMAIL_FROM="One Homes <hello@onehomes.example>"

# Salesforce
SF_LOGIN_URL=                 # e.g. https://login.salesforce.com
SF_CLIENT_ID=                 # (reserved for OAuth flow; not required for user/pass login)
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_TOKEN=                     # security token appended to password
SF_WEBHOOK_SECRET=            # HMAC secret to verify inbound Salesforce webhooks
# Optional custom field API name overrides (defaults shown)
SF_FIELD_AI_STATUS=AI_Status__c
SF_FIELD_QUALIFICATION=Qualification__c
SF_FIELD_VIEWING_BOOKED=Viewing_Booked__c
SF_FIELD_OPTED_OUT=Opted_Out__c
SF_FIELD_AI_HANDLED=AI_Handled__c
SF_LEAD_OBJECT=Lead

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Supabase / Postgres (Prisma)
DATABASE_URL=                 # pooled connection string (e.g. ...:6543/postgres?pgbouncer=true)
DIRECT_URL=                   # direct connection for migrations (e.g. ...:5432/postgres)

# Clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Business config
CONSULTANT_NAME="[YOUR NAME]"
CONSULTANT_CALENDAR_URL=      # for booking handoff
CONTACT_HOURS="08:00-20:00 Europe/London"
CONSULTANT_NOTIFY_EMAIL=      # where escalation/booking alerts are emailed
NEXT_PUBLIC_APP_URL=http://localhost:3000
