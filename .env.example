# Anthropic
ANTHROPIC_API_KEY=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=         # whatsapp:+44...  (dedicated business number)
TWILIO_TEMPLATE_INTRO_SID=    # approved template SID for first contact

# Resend
RESEND_API_KEY=
EMAIL_FROM="One Homes <hello@onehomes.example>"

# Salesforce
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_TOKEN=                     # Salesforce security token
SF_WEBHOOK_SECRET=            # HMAC secret to verify inbound Salesforce webhooks

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Supabase / Database
DATABASE_URL=                 # postgresql://... (Supabase connection string)

# Clerk Auth
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Business config
CONSULTANT_NAME="Your Name"
CONSULTANT_CALENDAR_URL=      # e.g. https://calendly.com/your-link
CONTACT_HOURS="08:00-20:00 Europe/London"

# App URL (required for Twilio webhook signature verification)
NEXT_PUBLIC_BASE_URL=         # e.g. https://your-app.vercel.app
