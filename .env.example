# ─────────────────────────────────────────────────────────────
# One Homes AI Lead Concierge — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Anthropic
ANTHROPIC_API_KEY=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=         # whatsapp:+44...  (dedicated business number)
TWILIO_TEMPLATE_INTRO_SID=    # approved template SID for first contact

# Resend
RESEND_API_KEY=
EMAIL_FROM="One Homes <hello@onehomes.example>"

# Salesforce
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_TOKEN=
SF_WEBHOOK_SECRET=            # HMAC secret to verify inbound Salesforce webhooks

# Salesforce custom field API names (override to match your org)
SF_FIELD_AI_STATUS=AI_Status__c
SF_FIELD_QUALIFICATION=Qualification__c
SF_FIELD_VIEWING_BOOKED=Viewing_Booked__c
SF_FIELD_OPTED_OUT=Opted_Out__c

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Database (Supabase Postgres)
DATABASE_URL=
DIRECT_URL=

# Clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Business config
CONSULTANT_NAME="[YOUR NAME]"
CONSULTANT_EMAIL=
CONSULTANT_PHONE=              # E.164, for escalation notifications via WhatsApp
CONSULTANT_CALENDAR_URL=      # for booking handoff
CONTACT_HOURS="08:00-20:00 Europe/London"
COMPANY_NAME="One Homes"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
